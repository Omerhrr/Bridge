# --- Application ---------------------------------------------------------
BRIDGE_ENVIRONMENT=development
BRIDGE_DEBUG=true

# --- Database ------------------------------------------------------------
# Local development uses SQLite by default. On Render use the internal
# PostgreSQL connection string, e.g.:
# postgresql://bridge_user:password@dpg-xxxx:5432/bridge
BRIDGE_DATABASE_URL=sqlite:///./bridge.db

# --- Security ------------------------------------------------------------
# When set, mutating /api/workflows requests require: Authorization: Bearer <token>
BRIDGE_API_TOKEN=

# --- Africa's Talking (https://account.africastalking.com) ---------------
BRIDGE_AT_USERNAME=
BRIDGE_AT_API_KEY=
BRIDGE_AT_SENDER_ID=

# --- Providers -----------------------------------------------------------
# comms: "mock" (offline dev/tests) | "africastalking" (needs credentials)
BRIDGE_COMMS_PROVIDER=mock
BRIDGE_AI_PROVIDER=mock
