# Bridge backend configuration (copy to .env and adjust)
# All variables are optional in development: without AT/AI credentials the
# platform runs on built-in stub providers so the full loop stays testable.

# Application
BRIDGE_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true

# Database (SQLite locally, PostgreSQL on Render)
DATABASE_URL=sqlite+aiosqlite:///./bridge.db

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Africa's Talking (spec section 25)
AT_USERNAME=sandbox
AT_API_KEY=
AT_PHONE_NUMBER=
AT_SENDER_ID=
AT_SANDBOX=true

# AI provider (spec section 26) - "stub" or e.g. "openai"
AI_PROVIDER=stub
AI_API_KEY=
AI_BASE_URL=
AI_STT_MODEL=
AI_TRANSLATION_MODEL=
AI_TTS_MODEL=

# Supported languages for translate-node validation (comma separated)
SUPPORTED_LANGUAGES=en,ha,sw,yo,ig,am,fr,ar,zu
